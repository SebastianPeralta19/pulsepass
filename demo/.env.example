# Plantilla de variables de entorno para desarrollo local.
# Copiar a .env (ignorado por git) o exportar en la shell. Nunca versionar la clave real.

# Clave HMAC Base64 de al menos 32 bytes aleatorios. Generarla, por ejemplo, con:
#   openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=

# Opcionales
PULSEPASS_JWT_ISSUER=pulsepass-api
PULSEPASS_JWT_ACCESS_TTL=PT15M
# Orígenes permitidos para CORS, separados por comas (vacío = CORS deshabilitado)
PULSEPASS_CORS_ALLOWED_ORIGINS=
